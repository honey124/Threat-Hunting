Checklist to follow when encountering a malicious file:

// Use this to check how the file got into the machine: 
union Device*
| where DeviceName contains "DEVICE"
| where * contains "PYXXW.exe"


// Use this to check if any network connections are there or not from the Process:"PYXXW.exe"
DeviceNetworkEvents
| where InitiatingProcessFileName == "Sim_EKB_Install_2018_11_14.exe"
| project Timestamp, InitiatingProcessFileName, RemoteUrl, RemotePort, ActionType, DeviceName
| order by Timestamp desc


// User this to check if any Child Process or Dlls files were created from the process "PYXXW.exe": 
DeviceProcessEvents
| where InitiatingProcessFileName == "Sim_EKB_Install_2018_11_14.exe"
| project Timestamp, DeviceName, ProcessId, InitiatingProcessFileName, FileName, ActionType, ProcessCommandLine, ReportId
| order by Timestamp desc


// User this to check for registry modification activities performed by the process PYXXW.exe
DeviceRegistryEvents
| where InitiatingProcessFileName == "Sim_EKB_Install_2018_11_14.exe"
| project Timestamp, DeviceName, InitiatingProcessFileName, RegistryKey, RegistryValueName, RegistryValueType, RegistryValueData, ActionType, ReportId
| order by Timestamp desc


//This query detects changes to Windows startup registry keys, commonly targeted by malware to control startup programs:
DeviceRegistryEvents 
| where DeviceName contains "DEVICE" 
| where ActionType == "RegistryValueSet" 
| where RegistryKey contains @"\Software\Microsoft\Windows\CurrentVersion\Run" or RegistryKey contains @"\Software\Microsoft\Windows\CurrentVersion\RunOnce" or RegistryKey contains @"\Software\Microsoft\Windows\CurrentVersion\RunServices" or RegistryKey contains @"\Software\Microsoft\Windows\CurrentVersion\RunServicesOnce" or RegistryKey contains @"\Software\Wow6432Node\Microsoft\Windows\CurrentVersion\Run"
 

This query tracks file events in Windows startup folders on a specific device to detect potential harmful programs:
DeviceFileEvents 
| where DeviceName contains "DEVICE" 
| where FolderPath contains @"C:\ProgramData\Microsoft\Windows\Start Menu\Programs\Startup" or FolderPath contains @"C:\Users\Public\Microsoft\Windows\Start Menu\Programs\Startup"

 
Find Out if any latralmoment happening on the Machine using below Query:
DeviceProcessEvents 
| where DeviceName contains "DEVICE" 
| where InitiatingProcessFileName in ("psexec.exe", "wmic.exe", "rundll32.exe", "wscript.exe", "cscript.exe", "powershell.exe", "mstsc.exe")
 

 
let mal_files = dynamic(["uqCNaKBp.exe", "cQeDEquW.exe", "RkMVspVw.exe", "JmcOhMMp.exe", "egZbxBwq.exe", "XwcpLWOC.exe", "wXgTNdUn.exe", "YsfKhspk.exe"]); 
union DeviceEvents, DeviceProcessEvents, DeviceFileEvents 
| where FileName has_any (mal_files) or InitiatingProcessFileName has_any (mal_files) or InitiatingProcessCommandLine has_any (mal_files) or ProcessCommandLine has_any (mal_files)
 

